<div>
  <section
    class="flex flex-col gap-4"
  >
    <div
      class="flex items-center justify-between gap-2"
    >
      <h2
        class="font-semibold text-gray-900"
      >
        Batches
      </h2>
      <button
        class="btn btn-primary"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-plus"
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M5 12h14"
          />
          <path
            d="M12 5v14"
          />
        </svg>
        Add new batch
      </button>
    </div>
    <ul
      class="flex flex-col gap-2 max-h-[60vh] overflow-y-auto"
    >
      <li
        class="card px-3 py-2.5 hover:border-gray-300 transition-colors"
      >
        <a
          class="flex items-center justify-between gap-2"
          href="/batches/batch-1"
        >
          <span
            class="inline-flex items-center gap-2 text-sm text-gray-900"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-loader-circle text-blue-500 animate-spin"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M21 12a9 9 0 1 1-6.219-8.56"
              />
            </svg>
            brave-tiger-a1b2c3
          </span>
          <span
            class="text-sm text-gray-500"
          >
            7
            /
            10
          </span>
        </a>
      </li>
      <li
        class="card px-3 py-2.5 hover:border-gray-300 transition-colors"
      >
        <a
          class="flex items-center justify-between gap-2"
          href="/batches/batch-2"
        >
          <span
            class="inline-flex items-center gap-2 text-sm text-gray-900"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-triangle-alert text-amber-500"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
              />
              <path
                d="M12 9v4"
              />
              <path
                d="M12 17h.01"
              />
            </svg>
            quiet-otter-9f8e7d
          </span>
          <span
            class="text-sm text-gray-500"
          >
            10
            /
            10
          </span>
        </a>
      </li>
      <li
        class="card px-3 py-2.5 hover:border-gray-300 transition-colors"
      >
        <a
          class="flex items-center justify-between gap-2"
          href="/batches/batch-3"
        >
          <span
            class="inline-flex items-center gap-2 text-sm text-gray-900"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-circle-x text-red-600"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
              />
              <path
                d="m15 9-6 6"
              />
              <path
                d="m9 9 6 6"
              />
            </svg>
            lucky-panda-3c2b1a
          </span>
          <span
            class="text-sm text-gray-500"
          >
            4
            /
            10
          </span>
        </a>
      </li>
    </ul>
    <button
      class="btn self-center"
      type="button"
    >
      Load more
    </button>
  </section>
  <dialog
    class="m-auto rounded-xl p-0 border border-gray-200 shadow-2xl backdrop:bg-black/50 max-w-xl w-[calc(100%-2rem)]"
  >
    <div
      class="flex flex-col gap-4 p-5"
    >
      <div
        class="flex items-center justify-between gap-2"
      >
        <h2
          class="font-semibold text-gray-900"
        >
          Add new batch
        </h2>
        <button
          aria-label="Close"
          class="text-gray-400 hover:text-gray-700 transition-colors"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-x"
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18 6 6 18"
            />
            <path
              d="m6 6 12 12"
            />
          </svg>
        </button>
      </div>
      <section
        class="flex flex-col gap-4"
      >
        <form
          class="flex flex-col gap-2"
        >
          <div
            class="flex items-center justify-between gap-2"
          >
            <label
              class="font-medium text-sm text-gray-700"
              for="urls-textarea"
            >
              Paste URLs (space or newline separated)
            </label>
            <span
              class="text-xs text-gray-400"
            >
              0
               / 
              500
            </span>
          </div>
          <textarea
            class="border border-gray-200 rounded-lg p-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-slate-900/10"
            id="urls-textarea"
            name="urls"
            placeholder="https://example.com
https://another-example.com"
            rows="6"
          />
          <button
            class="btn btn-primary self-start"
            type="submit"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-list-plus"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M16 5H3"
              />
              <path
                d="M11 12H3"
              />
              <path
                d="M16 19H3"
              />
              <path
                d="M18 9v6"
              />
              <path
                d="M21 12h-6"
              />
            </svg>
            Submit pasted URLs
          </button>
        </form>
        <div
          class="flex flex-col gap-2 border-t border-gray-100 pt-4"
        >
          <label
            class="font-medium text-sm text-gray-700"
            for="csv-input"
          >
            Or upload a CSV
          </label>
          <input
            accept=".csv,text/csv"
            class="text-sm text-gray-600 file:mr-3 file:rounded-lg file:border file:border-gray-200 file:bg-white file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-gray-900 hover:file:bg-gray-50 file:cursor-pointer"
            id="csv-input"
            type="file"
          />
          <button
            class="btn self-start"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-upload"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12 3v12"
              />
              <path
                d="m17 8-5-5-5 5"
              />
              <path
                d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              />
            </svg>
            Upload CSV
          </button>
        </div>
      </section>
    </div>
  </dialog>
</div>