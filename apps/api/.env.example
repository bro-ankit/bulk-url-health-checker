PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=bulk_url_health_checker

REDIS_HOST=localhost
REDIS_PORT=6381

S3_ENDPOINT=http://localhost:4567
# Only needed when S3_ENDPOINT is a host the browser can't resolve (e.g. a Docker service name).
# Overrides the origin of the presigned upload url returned to the browser. Defaults to
# S3_ENDPOINT when unset, which is correct for this native (non-Docker) local setup.
# S3_PUBLIC_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_BUCKET_NAME=bulk-url-health-checker
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
